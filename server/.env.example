# Copy to server/.env and replace every value. Never commit real secrets.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
REACT_APP_DOMAIN=http://localhost:3001
MONGODB_URI=mongodb://localhost:27017/howdy?replicaSet=rs0
SESSION_SECRET_PASSCODE=REPLACE_WITH_A_LONG_RANDOM_SECRET
AUTH_SECRET_ENCODING_PASSPHRASE=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
USER_ACTIVATION_TOKEN_SECRET_ENCODING_PASSPHRASE=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
USER_CHANGE_PASSWORD_TOKEN_SECRET_ENCODING_PASSPHRASE=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_EMAIL=you@example.com
GMAIL_PASSWORD=YOUR_SMTP_APP_PASSWORD
# Required for multi-instance or production authentication throttling.
# Optional for local development; set a Redis URL for production or shared rate limiting.
# Example: redis://127.0.0.1:6379
REDIS_URL=
