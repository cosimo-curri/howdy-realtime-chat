<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/authLayout"
    android:background="#ffffff"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AuthActivity">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/profilePicture"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription, ImageContrastCheck" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/loadingProfilePictureLayout"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/loadingProfilePicture"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:indeterminateTint="#00af23"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </android.support.constraint.ConstraintLayout>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/layoutUserInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="105dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/profilePicture"
        app:layout_constraintTop_toTopOf="parent">

        <android.support.constraint.ConstraintLayout
            android:id="@+id/layoutUserInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/lblUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_extrabold"
                android:maxLines="1"
                android:background="@drawable/txt_loading_background"
                android:text="@string/username_space"
                android:textColor="#CCCCCC"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="TextContrastCheck" />

            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins"
                android:maxLines="1"
                android:background="@drawable/txt_loading_background"
                android:text="@string/email_space"
                android:textColor="#CCCCCC"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/lblUsername"
                tools:ignore="TextContrastCheck" />

        </android.support.constraint.ConstraintLayout>

    </android.support.constraint.ConstraintLayout>

    <android.support.constraint.ConstraintLayout
        android:id="@+id/txtNumberLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblCode2FA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extrabold"
            android:text="@string/auth_2fa"
            android:textColor="#43A047"
            android:textSize="35sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <android.support.constraint.ConstraintLayout
            android:id="@+id/txtNumberLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblCode2FA">

            <EditText
                android:id="@+id/txtNumber1"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber2"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber2"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber3"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber3"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber4"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber4"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber5"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber5"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber6"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber6"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="60dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="70"
                android:foregroundGravity="bottom"
                android:progressDrawable="@drawable/circular_progress_bar"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </android.support.constraint.ConstraintLayout>

    </android.support.constraint.ConstraintLayout>

    <ImageView
        android:id="@+id/imgLogout"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:soundEffectsEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/power_off_solid"
        tools:ignore="ContentDescription, ImageContrastCheck" />

    <ImageView
        android:id="@+id/imgVolume"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:soundEffectsEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/imgLogout"
        app:srcCompat="@drawable/volume"
        app:tint="#00af23"
        tools:ignore="ContentDescription, ImageContrastCheck" />

    <android.support.constraint.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgDayNight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@+id/switchDayNight"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/sun"
            tools:ignore="ContentDescription, ImageContrastCheck" />

        <com.suke.widget.SwitchButton
            android:id="@+id/switchDayNight"
            android:layout_width="76dp"
            android:layout_height="40dp"
            android:soundEffectsEnabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:sb_background="#00af23"
            app:sb_button_color="#f3f3f3"
            app:sb_checked_color="#00af23"
            app:sb_show_indicator="false"
            app:sb_uncheck_color="#00af23"
            tools:ignore="SpeakableTextPresentCheck, TouchTargetSizeCheck" />

    </android.support.constraint.ConstraintLayout>

</android.support.constraint.ConstraintLayout>