<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/randomAuthCodeLayout"
    android:background="#ffffff"
    tools:context=".RandomAuthCodeActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo"
        tools:ignore="ContentDescription, ImageContrastCheck" />

    <android.support.constraint.ConstraintLayout
        android:id="@+id/txtNumberLayoutContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblCode2FA"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_extrabold"
            android:text="@string/auth_2fa"
            android:textColor="#43A047"
            android:textSize="35sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <android.support.constraint.ConstraintLayout
            android:id="@+id/txtNumberLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lblCode2FA">

            <EditText
                android:id="@+id/txtNumber1"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber2"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber2"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber3"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber3"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber4"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber4"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber5"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber5"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toStartOf="@+id/txtNumber6"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

            <EditText
                android:id="@+id/txtNumber6"
                android:layout_width="42dp"
                android:layout_height="50dp"
                android:background="@drawable/edit_text_border_bottom"
                android:fontFamily="@font/poppins"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="1"
                android:textAlignment="center"
                android:textColorHint="#A9A9A9"
                android:textColor="#808080"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SpeakableTextPresentCheck" />

        </android.support.constraint.ConstraintLayout>

    </android.support.constraint.ConstraintLayout>

</android.support.constraint.ConstraintLayout>